  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "start": "node --enable-source-maps dist/index.js",
    "dev": "LOG_LEVEL=debug tsx watch --clear-screen=false src/index.ts",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0",
  "dependencies": {
    "@fastify/type-provider-json-schema-to-ts": "^5.0.1",
    "@kubernetes/client-node": "^2.0.1",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/pino": "^7.0.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
